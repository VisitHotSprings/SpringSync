# Local development overrides (ODNAS_* env vars). Placeholders only.
# Production uses /etc/springsync/springsync.toml + systemd credentials instead.
# Secrets are NEVER env vars: they are files (data.key, entra-app.key,
# entra-client-secret) in $CREDENTIALS_DIRECTORY or ODNAS_KEYS_DIR.
ODNAS_TENANT_ID=00000000-0000-0000-0000-000000000000
ODNAS_CLIENT_ID=00000000-0000-0000-0000-000000000000
ODNAS_BASE_URL=https://sync.example.invalid
ODNAS_CREDENTIAL_TYPE=certificate
ODNAS_TOKEN_MODE=broker
ODNAS_COOKIE_SECURE=true
ODNAS_DB_PATH=./var/db/springsync.db
ODNAS_STATE_DIR=./var/state
ODNAS_LOG_DIR=./var/log
ODNAS_RUNTIME_DIR=./var/run
ODNAS_MOUNT_ROOT=./var/mnt
ODNAS_KEYS_DIR=./var/keys
ODNAS_GROUP_USERS=
ODNAS_GROUP_ADMINS=
ODNAS_GROUP_AUDITORS=
