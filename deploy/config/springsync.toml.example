# /etc/springsync/springsync.toml : bootstrap only, NO SECRETS (SPEC §8.2).
# Everything operational (NAS address, schedule, alerts, pilot list, group IDs)
# is edited in the admin GUI and stored in the DB.

[app]
product_name = "SpringSync"          # working name; final name is an open decision
slug = "springsync"                  # paths, unit names, check/archive file names
org_name = "VisitHotSprings"         # User-Agent NONISV|<org>|<product>/<ver>
base_url = "https://sync.hotsprings.org"

[entra]
tenant_id = "00000000-0000-0000-0000-000000000000"   # VHS tenant GUID (single-tenant)
client_id = "00000000-0000-0000-0000-000000000000"   # app registration (client) ID
credential_type = "certificate"                     # or "secret" (fallback, max 24 months)
cert_path = "/etc/springsync/keys/entra-app.crt"    # public cert; private key via systemd credential
token_mode = "broker"                               # "tmpfs_config" = fallback if lab test T-A3 fails (needs secret)
allowed_upn_domain = "hotsprings.org"
# bootstrap group object IDs (GUI can change them later)
group_users = ""
group_admins = ""
group_auditors = ""

[google]
# v0.9, optional: Google Drive (My Drive) as a user's connected cloud drive (SPEC §4.3, §4.4).
# App sign-in stays Microsoft for everyone; Google is only "Connect Google Drive" on the user's page.
# Empty client_id = Google not configured. The client SECRET is NOT here: it is the systemd credential
# "google-client.secret" (/etc/springsync/creds/google-client.secret.cred). Creating the Google Cloud
# project / OAuth client needs Mark's OK and his Google admin sign-in (docs/DEPLOY.md).
client_id = ""                 # <digits>-<id>.apps.googleusercontent.com
allowed_domain = "hotsprings.org"
# redirect_path = "/auth/google/callback"

[nas]
nas_host = "unas.hotsprings.local"
nas_share = "Personal-Drive"

[auto_update]
# v0.11, SPEC §11.4.1: opt-in nightly auto-update (Ubuntu host). OFF unless set here; the GUI only shows it.
# When on, the <slug>-autoupdate timer (02:45 Central + up to 30 min, after the 02:30 backup) installs the newest PATCH release of the
# running minor version (v0.11.x) through deploy/update.sh, only from a normal published GitHub release
# (never a draft, a pre-release or a tag with a suffix), only 24 h after it was published, and never while a
# Mirror run, an approval or a safety hold is pending. A new minor/major is alerted and waits for a manual update.sh.
# A failed update rolls back and turns auto-update off (/etc/springsync/auto-update.disabled) until an
# admin runs: sudo /opt/springsync/current/deploy/auto-update.sh --reenable
enabled = false
repo = "VisitHotSprings/SpringSync"
# Once tag signing exists: refuse unsigned tags and tags not signed by an allowed key.
require_signed_tags = false
# allowed_signers = "/etc/springsync/deploy/allowed_signers"   # ssh signing keys (git gpg.ssh.allowedSignersFile)
